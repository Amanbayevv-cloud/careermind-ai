# Public browser configuration ONLY. Supabase anon key is public and protected by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Set these in Supabase Edge Function secrets, NEVER in VITE_ variables:
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-4o-mini
# ALLOWED_ORIGIN=https://your-app-domain.example
